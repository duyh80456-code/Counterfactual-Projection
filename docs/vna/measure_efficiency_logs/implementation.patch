+class Native(nn.Module):
+    def __init__(self):
+        super().__init__()
+        self.layers = nn.Sequential(nn.Linear(3, 2), nn.ReLU(), nn.Linear(2, 3))
+    def predict(self, x):
+        feature = self.layers[:2](x)
+        return self.layers[2](feature), [feature]
